# Replace the hostname and certificate paths before installation.
# The service itself listens on 127.0.0.1:4310 only. This proxy is the only
# public surface, so it terminates TLS for both the /v1 API and the /admin UI.
server {
    listen 443 ssl;
    server_name moderation.example.cn;
    ssl_certificate /etc/nginx/tls/moderation/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/moderation/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 256k;

    # Never cache authenticated responses, pages, or assets with session state.
    proxy_no_cache 1;
    proxy_cache_bypass 1;

    location /v1/ {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }

    # Admin UI and /admin/api. Session cookies are HttpOnly + Secure + SameSite,
    # so this block must stay on HTTPS and on one hostname (no mixed origins).
    location /admin {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;

        # Keep /admin out of search engines and out of framing.
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        add_header Cache-Control "no-store" always;

        # Optional but recommended: restrict the admin surface to trusted
        # source addresses or a VPN. Keep the include commented out until the
        # operator has confirmed the allowlist.
        # include /etc/nginx/snippets/moderation-admin-allow.conf;
    }

    location /healthz {
        proxy_pass http://127.0.0.1:4310;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_connect_timeout 3s;
        proxy_read_timeout 5s;
        access_log off;
    }

    location / {
        return 404;
    }
}

# Optional: force HTTPS so the Secure session cookie is always sent, and so an
# unencrypted login POST can never reach the service.
server {
    listen 80;
    server_name moderation.example.cn;
    return 301 https://$host$request_uri;
}
