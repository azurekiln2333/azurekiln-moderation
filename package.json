{
  "name": "azurekiln-moderation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "workspaces": ["packages/client"],
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node scripts/migrate.mjs",
    "lint": "node scripts/check.mjs",
    "test": "node --test test/core/*.test.js test/ext/*.test.js test/admin/*.test.js packages/client/test/*.test.cjs",
    "test:core": "node --test test/core/*.test.js",
    "test:ext": "node --test test/ext/*.test.js",
    "test:admin": "node --test test/admin/*.test.js",
    "test:client": "node --test packages/client/test/*.test.cjs",
    "data:import": "node scripts/import-words.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "ipaddr.js": "2.5.0",
    "opencc-js": "1.4.2"
  }
}
