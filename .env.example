# 复制为同目录下的 .env，并执行 chmod 600 .env；docker compose 会自动读取。
# 不要提交 .env。

# 接入方凭据（必填）：每个应用一组 appId、apiKey、adminKey。
# 密钥至少 32 个字符且互不相同，可用 openssl rand -hex 32 生成。
MODERATION_APPS_JSON='[{"appId":"qflistudio","apiKey":"<替换为随机密钥>","adminKey":"<替换为随机密钥>"},{"appId":"azurekiln-oauth2","apiKey":"<替换为随机密钥>","adminKey":"<替换为随机密钥>"}]'

# 镜像（可选）：默认使用 CNB 的 latest；可改用 GHCR，或固定为某个版本或摘要。
# MODERATION_IMAGE=docker.cnb.cool/azurekiln/azurekiln-moderation/moderation:latest
# MODERATION_IMAGE=ghcr.io/azurekiln2333/azurekiln-moderation:latest

# 其他可选项
# COMPOSE_PROJECT_NAME=azurekiln-moderation
# MODERATION_PORT=4310
# MODERATION_DATA_VOLUME=azurekiln-moderation-data
# WATCHTOWER_POLL_INTERVAL=600
